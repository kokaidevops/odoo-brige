# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://your-frontend-domain.com

# ============================================
# POSTGRESQL (Bridge Local DB - for caching & audit)
# ============================================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=odoo_bridge
PG_USER=bridge_user
PG_PASSWORD=your_secure_password
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=30000
PG_POOL_CONNECTION_TIMEOUT=5000

# ============================================
# ODOO 16 POSTGRESQL (Direct connection - bypass ORM)
# ============================================
ODOO_PG_HOST=localhost
ODOO_PG_PORT=5432
ODOO_PG_DATABASE=odoo16_db
ODOO_PG_USER=odoo_readonly_user
ODOO_PG_PASSWORD=odoo_readonly_password
ODOO_PG_POOL_MAX=10
ODOO_PG_POOL_IDLE_TIMEOUT=30000

# ============================================
# AUTHENTICATION
# ============================================
# Secret key for signing push tokens from Odoo
PUSH_SECRET_KEY=your_very_long_and_secure_secret_key_here

# JWT for frontend auth
JWT_SECRET=another_very_long_and_secure_jwt_secret_here
JWT_EXPIRES_IN=24h

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs